# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# IDE and operating-system state
.idea/
.vscode/
.DS_Store
Thumbs.db

# Raw or local data
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/README.md

# Serialized models and temporary artifacts
outputs/models/*
outputs/figures/*
outputs/reports/*
outputs/logs/failures/*
submission/model/*.joblib

# Bulk reproducible predictions: retain only the frozen Task 1 candidate OOF evidence
outputs/predictions/*
!outputs/predictions/task1_non_sleep_nested_residual_correction_oof_predictions.csv
!outputs/predictions/task2_frozen_candidate_oof_predictions.csv

# Local scratch and temporary files
*.tmp
*.temp
*.bak
~$*
